{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2021",
    "module": "commonjs",
    "rootDir": "./src",
    "baseUrl": "./src",
    "types": ["node"],
    "sourceMap": true,
    "outDir": "build",
    "esModuleInterop": true,
    "strict": true,
    "erasableSyntaxOnly": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}